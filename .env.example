# -----------------------------------------------
# App
# -----------------------------------------------
APP_NAME="Kletterdom Check-in"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://192.168.x.x
APP_TIMEZONE=Europe/Vienna

# -----------------------------------------------
# TLS / Nginx
# -----------------------------------------------
SSL_SUBJECT_ALT_NAME=IP:192.168.x.x,DNS:kletterdom.local

# -----------------------------------------------
# Database (MySQL via Docker)
# -----------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_DATABASE=klettercheckin
DB_USERNAME=checkinuser
DB_PASSWORD=
DB_ROOT_PASSWORD=

# -----------------------------------------------
# HMAC secret used to derive name_birth_hash for the member match.
# Must stay stable for the lifetime of the install: if you change it,
# CSV members no longer match registrations. Generate once with:
#   php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# -----------------------------------------------
HASH_KEY=

# -----------------------------------------------
# Session (PHP file sessions)
# -----------------------------------------------
SESSION_LIFETIME_MINUTES=120
SESSION_REMEMBER_DAYS=30
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax

# -----------------------------------------------
# Optional: bootstrap admin via deploy.sh
# -----------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
