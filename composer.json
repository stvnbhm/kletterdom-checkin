{
    "name": "kletterdom/checkin",
    "description": "Plain-PHP check-in app for Kletterdom Langenlois",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "endroid/qr-code": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Kletterdom\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
